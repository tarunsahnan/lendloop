      "parameters": {
        "jsCode": "const { headers } = $input.first().json;\n\nlet rawBody = '';\ntry {\n  rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch {\n  // An empty request has no binary part. It fails verification below.\n}\n\nreturn [{\n  json: {\n    timestamp: headers['x-ll-timestamp'] ?? '',\n    signature: headers['x-ll-signature'] ?? '',\n    rawBody,\n  },\n}];"
      }
    },
