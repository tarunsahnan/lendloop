      "parameters": {
        "jsCode": "const loan = $('Loop over loans').first().json;\nconst { recipient, toolName, daysOverdue } = loan;\n\n// Behaves like a provider's bounce-simulator address, so the failure path can be exercised.\nif (recipient.firstName === 'Bounce') {\n  throw new Error('Simulated provider bounce');\n}\n\nreturn [{\n  json: {\n    channel: 'mock',\n    recipientId: recipient.id,\n    message: `Hi ${recipient.firstName}, the ${toolName} you borrowed is ${daysOverdue} day(s) overdue.`,\n    deliveredAt: new Date().toISOString(),\n  },\n}];"
