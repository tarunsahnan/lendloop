    {
      "id": "event-010",
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        -40
      ],
      "parameters": {
        "jsCode": "const { eventId, type, toolName, startDate, endDate, recipient } = $input.first().json.body;\nconst dates = `${startDate} to ${endDate}`;\n\nconst messages = {\n  'loan.requested': `someone asked to borrow your ${toolName} for ${dates}.`,\n  'loan.approved': `your request for the ${toolName} (${dates}) was approved.`,\n  'loan.declined': `your request for the ${toolName} (${dates}) was declined.`,\n  'loan.cancelled': `the loan of the ${toolName} (${dates}) was cancelled.`,\n  'loan.returned': `the ${toolName} was marked as returned. Thanks!`,\n};\n\nreturn [{\n  json: {\n    eventId,\n    recipientId: recipient.id,\n    firstName: recipient.firstName,\n    message: `Hi ${recipient.firstName}, ${messages[type]}`,\n  },\n}];"
      }
    },
    {
      "id": "event-011",
      "name": "Notify (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        -40
      ],
      "parameters": {
        "jsCode": "const { recipientId, firstName, message } = $input.first().json;\n\n// Behaves like a provider's bounce-simulator address, so the failure path can be exercised.\nif (firstName === 'Bounce') {\n  throw new Error('Simulated provider bounce');\n}\n\nreturn [{ json: { channel: 'mock', recipientId, message, deliveredAt: new Date().toISOString() } }];"
      },
      "onError": "continueErrorOutput"
    },
