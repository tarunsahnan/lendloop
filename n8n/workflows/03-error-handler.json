      "parameters": {
        "content": "## Error handler\nRuns when a workflow execution fails, and reports it to Convex so it appears on the admin page.\n\nOnly the workflow name, execution id and failed node are sent: no payload or user data. The write is keyed on execution id, so a retry cannot create a second record.",
        "width": 760,
        "height": 140,
        "color": 7
      }
    },
    {
      "id": "errors-002",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "errors-003",
      "name": "Minimal report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const { execution, trigger, workflow } = $input.first().json;\n\nreturn [{\n  json: {\n    executionId: execution?.id,\n    workflowName: workflow?.name ?? 'unknown',\n    failedNode: execution?.lastNodeExecuted ?? trigger?.error?.node?.name ?? 'trigger',\n  },\n}];"
      }
    },
    {
