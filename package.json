{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "n8n:up": "docker compose --env-file .env.local up -d",
    "n8n:down": "docker compose --env-file .env.local down",
    "demo:seed": "convex run demo:seed",
    "demo:overdue": "convex run demo:triggerOverdueRun",
    "make-admin": "convex run users:promoteToAdmin"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "convex": "^1.49.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.69",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
