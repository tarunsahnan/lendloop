# Copy to .env.local, fill in the two Clerk keys, then run: npm run setup
# Everything else is generated or written for you.

# Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public address of the app. Used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generated by npm run setup. Never commit real values.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
N8N_ENCRYPTION_KEY=

# Written by Convex on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
